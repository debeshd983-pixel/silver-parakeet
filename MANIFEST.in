# The INT8 CLIP encoder (~85.5 MB raw) and the fitted probe head are included in BOTH the
# sdist and the wheel so that `pip install sahu65` works with no download step and no
# cold-start stall, and so that a source install also works.
#
# Do NOT add an `exclude sahu65/models/clip_encoder.int8.onnx` line to keep the sdist
# small. It appears to scope to the sdist only, but setuptools also applies it when
# building the wheel, which silently strips the encoder from the wheel and produces a
# package that cannot run. Verified: with the exclude, the wheel was 37 KB with no model.
include README.md
include LICENSE
include MODEL_CARD.md
include requirements.txt
recursive-include sahu65 *.py
recursive-include sahu65/models *.onnx *.json
recursive-include sahu65/config *.json
prune tests
prune scripts
prune assets
prune models
prune .venv
global-exclude __pycache__ *.pyc
